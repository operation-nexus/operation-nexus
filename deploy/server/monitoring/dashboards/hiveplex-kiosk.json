{
 "uid": "hiveplex-kiosk",
 "title": "Hiveplex at a glance (kiosk)",
 "tags": [
  "hiveplex",
  "kiosk"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 5,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "rate",
    "label": "Rate $/kWh",
    "type": "custom",
    "hide": 2,
    "query": "0.2124",
    "current": {
     "text": "0.2124",
     "value": "0.2124"
    },
    "options": [
     {
      "text": "0.2124",
      "value": "0.2124",
      "selected": true
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "INTERNET",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 2
   },
   "targets": [
    {
     "expr": "min(probe_success{job=~\"ping|web\",kind=\"internet\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "ONLINE",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "text": {
     "titleSize": 22,
     "valueSize": 36
    }
   }
  },
