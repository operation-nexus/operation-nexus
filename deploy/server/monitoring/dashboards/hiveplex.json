  {
   "id": 11,
   "type": "stat",
   "title": "Cost this month so far (from recorded watts)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(sum_over_time(kasa_power_watts[$__range:1m])) / 60 / 1000 * $rate",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "description": "Recorded watts added up since the 1st of this month (the plugs were installed 25 Oct, so October is partial) times the rate chosen at the top. Short gaps in the recording count as zero.",
   "timeFrom": "now/M"
  },
