{
 "uid": "hiveplex-overview",
 "title": "Hiveplex: server, network, power and cost",
 "tags": [
  "hiveplex"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "rate",
    "label": "Rate $/kWh",
    "type": "custom",
    "query": "marginal (supply + variable delivery) : 0.2094,all-in average (bill / kWh) : 0.2551",
    "current": {
     "text": "marginal (supply + variable delivery)",
     "value": "0.2094"
    },
    "options": [
     {
      "text": "marginal (supply + variable delivery)",
      "value": "0.2094",
      "selected": true
     },
     {
      "text": "all-in average (bill / kWh)",
      "value": "0.2551",
      "selected": false
     }
    ],
    "hide": 0
   }
  ]
 },
