#!/usr/bin/env bash
# Post a message to the Discord alerts webhook. Usage: hiveplex-notify "message"   (run as root)
# The URL lives only in /etc/hiveplex-alerts.env (mode 600). Mentions are disabled.
set -u
# Test switch: while this file exists, pretend Discord is unreachable (used to test the alert retry queue).
[ -e /var/lib/hiveplex-health/simulate-notify-failure ] && { echo 'hiveplex-notify: simulated failure' >&2; exit 1; }
ENV=/etc/hiveplex-alerts.env
[ -r "$ENV" ] || { echo "hiveplex-notify: cannot read $ENV (run as root)" >&2; exit 2; }
# shellcheck disable=SC1090
. "$ENV"
[ -n "${DISCORD_WEBHOOK_URL:-}" ] || { echo "hiveplex-notify: DISCORD_WEBHOOK_URL not set" >&2; exit 2; }
msg="${1:-}"; [ -n "$msg" ] || { echo "usage: hiveplex-notify MESSAGE" >&2; exit 2; }
payload=$(python3 -c 'import json,sys; m=sys.argv[1][:1900]; print(json.dumps({"content": m, "allowed_mentions": {"parse": []}}))' "$msg")
code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 -H 'Content-Type: application/json' -d "$payload" "$DISCORD_WEBHOOK_URL") || { echo "hiveplex-notify: curl failed" >&2; exit 1; }
case "$code" in 200|204) exit 0;; *) echo "hiveplex-notify: Discord returned HTTP $code" >&2; exit 1;; esac
