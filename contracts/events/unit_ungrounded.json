{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/unit_ungrounded.json",
  "title": "UnitUngrounded",
  "description": "A grounded unit's home base paid its upkeep at an economy window (CONTRACTS §6; ECONOMY EC-6; NX-412 part 2): it may take jobs and orders again. Once per change. Public view: the coalition sees its own units (a feed line, GAMEPLAY §1a); ENEMY dropped (proposed).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "entity_id", "node_id"],
  "properties": {
    "kind": {"const": "UnitUngrounded"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "entity_id": {"$ref": "../common/ids.json#/$defs/EntityId", "description": "The unit ungrounded."},
    "node_id": {"$ref": "../common/ids.json#/$defs/NodeId", "description": "The unit's home base (ECONOMY EC-5)."}
  }
}
